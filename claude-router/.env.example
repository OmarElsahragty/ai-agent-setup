# claude-router environment (empty values: fill in and keep this file 0600).
# The router reads these from the process environment (systemd EnvironmentFile= or .env).

# Setup root. Empty = the repo directory this deployment lives in.
AI_SETUP_ROOT=

# Anthropic API key: retry of the main/compaction lanes when the subscription credential is rate-limited.
ANTHROPIC_API_KEY=

# OpenCode Go lane.
OPENCODE_GO_API_KEY=
OPENCODE_GO_FALLBACK_MODEL=
OPENCODE_GO_MAX_CONCURRENT=
OPENCODE_GO_QUEUE_TIMEOUT_MS=
OPENCODE_GO_429_MAX_ATTEMPTS=
OPENCODE_GO_BREAKER_FAILS=
OPENCODE_GO_BREAKER_COOLDOWN_MS=

# Fallback queue to Anthropic.
FALLBACK_MAX_CONCURRENT=
FALLBACK_QUEUE_MAX_WAIT_MS=

# Role plan override: "<target>:<model>:<fallback>:<effort>", e.g.
# SUBAGENT_PRIMARY=opencode-go   (emergency: every role on one lane, no per-role plan)
SUBAGENT_PRIMARY=
ROLE_PLAN_IMPLEMENTER=

# Paths.
ROUTER_USAGE_LOG=
CLAUDE_ROUTER_FALLBACK_STATE=

# Test-only switches (never set these in production).
NODE_TEST_CONTEXT=
OPENCODE_GO_SIMULATE_STATUS=
