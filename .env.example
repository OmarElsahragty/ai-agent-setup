# .env.example — every key this setup reads, with an empty value.
# Copy to .env, fill what you use, and keep it 0600. .env is never committed.
# Empty/absent keys leave that component on its built-in default (or disabled).

# --- setup identity ----------------------------------------------------------
# Where this repo lives. Empty = the repo directory (scripts fall back to it).
AI_SETUP_ROOT=
# Public domain of the optional web UI / voice routes, e.g. agents.example.com.
AI_SETUP_DOMAIN=
# Hostname the hub advertises to off-box clients.
AI_SETUP_HOST=
# Display name written into the rendered OpenCode config.
AI_SETUP_USER=

# --- model providers ---------------------------------------------------------
# Anthropic: subscription first, then this key for the router's retry lane.
ANTHROPIC_API_KEY=
# OpenCode Go (OpenCode CLI + the router's fallback lane).
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=
OPENCODE_GO_FALLBACK_MODEL=
# Google: the voice gateway mints Gemini Live tokens with this key.
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# OpenAI (optional, only for MCP servers you enable yourself).
OPENAI_API_KEY=

# --- internet + MCP server credentials ---------------------------------------
# The exa MCP server is the only internet tool the agents are allowed to use.
EXA_API_KEY=
CLOUDFLARE_API_TOKEN=
TESTSPRITE_API_KEY=
CLOUDSDK_CORE_DISABLE_PROMPTS=
DISABLE_THOUGHT_LOGGING=
PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=

# --- databases ---------------------------------------------------------------
POSTGRES_CONNECTION_STRING=
UNIFIED_MEMORY_PG_DSN=
UNIFIED_MEMORY_DB=
WORK_MEMORY_PG_DSN=
DB_PASS=
DB_PW=

