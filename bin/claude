#!/bin/bash
# Wrapper to guarantee clean environment, local routing, and auto-compaction for Claude Code
unset ANTHROPIC_AUTH_TOKEN
unset ANTHROPIC_API_KEY
export ANTHROPIC_BASE_URL="${ANTHROPIC_BASE_URL:-http://127.0.0.1:3920}"
export ANTHROPIC_DEFAULT_OPUS_MODEL="claude-opus-5-5"
export ANTHROPIC_DEFAULT_SONNET_MODEL="claude-sonnet-5-5"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="claude-haiku-5-5"
export CLAUDE_CODE_AUTO_COMPACT_WINDOW="300000"
export CLAUDE_CODE_MAX_CONTEXT_TOKENS="1000000"
export CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS="1"
export CLAUDE_CODE_DISABLE_AUTO_MEMORY="1"
# 2026-09-23: Claude Code temp (task output, scratchpads) on disk, not the 4G RAM-backed /tmp:
# a runaway `--success` test log (3.3 GB) filled /tmp and gave every session ENOSPC.
export CLAUDE_CODE_TMPDIR="/var/tmp/claude"
# 2026-09-23: child tools (vitest mints join(tmpdir(), nanoid()) caches and leaks them when a
# `timeout` wrapper kills the run) inherit TMPDIR; 1,509 such dirs filled the RAM-backed /tmp.
export TMPDIR="/var/tmp/claude"
# Allow bypassPermissions under root: host runs as root by design (self-hosted root host).
# ponytail: disables root guardrail; revisit if Claude Code grows a proper --allow-root
export IS_SANDBOX=1

# Default arguments: --autocompact 300000 (60% of the 1M window) and --model claude-opus-5-5[1m].
# The [1m] suffix is REQUIRED: without it the CLI resolves a 200K model window and
# silently clamps the autocompact window down to 200000 (min(modelWindow, configured)).
SUBCOMMANDS=("agents" "attach" "auth" "auto-mode" "config" "doctor" "gateway" "import" "install" "logs" "mcp" "plugin" "plugins" "project" "respawn" "rm" "setup-token" "stop" "kill" "ultrareview" "update" "upgrade")
IS_SUBCOMMAND=0
for sc in "${SUBCOMMANDS[@]}"; do
  if [[ "$1" == "$sc" ]]; then
    IS_SUBCOMMAND=1
    break
  fi
done

EXTRA_ARGS=()
if [[ $IS_SUBCOMMAND -eq 0 ]]; then
  if [[ ! "$*" =~ "--autocompact" ]]; then
    EXTRA_ARGS+=(--autocompact 300000)
  fi
  if [[ ! "$*" =~ "--model" ]]; then
    EXTRA_ARGS+=(--model "claude-opus-5-5[1m]")
  fi
fi

# Locate the CLI: CLAUDE_CLI_PATH wins, then the stock install path, then the first `claude` on PATH that
# is not this wrapper. The wrapper is compared by resolved path AND by content, so a second installed copy
# can never make the two exec each other.
SELF_PATH="${BASH_SOURCE[0]}"
case "$SELF_PATH" in
  */*) ;;
  *) SELF_PATH="$(command -v -- "$SELF_PATH" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")" ;;
esac
WRAPPER_SELF="$(readlink -f -- "$SELF_PATH" 2>/dev/null || printf '%s' "$SELF_PATH")"
WRAPPER_SIZE="$(stat -c %s -- "$SELF_PATH" 2>/dev/null || echo 0)"

resolve_claude_cli() {
  local candidate dir
  if [ -n "${CLAUDE_CLI_PATH:-}" ]; then printf '%s\n' "$CLAUDE_CLI_PATH"; return 0; fi
  candidate="/usr/lib/node_modules/@anthropic-ai/claude-code/bin/claude.exe"
  if [ -f "$candidate" ] && [ -x "$candidate" ]; then printf '%s\n' "$candidate"; return 0; fi
  local IFS=:
  for dir in $PATH; do
    candidate="${dir:-.}/claude"
    { [ -f "$candidate" ] && [ -x "$candidate" ]; } || continue
    [ "$(readlink -f -- "$candidate" 2>/dev/null)" = "$WRAPPER_SELF" ] && continue
    if [ "$(stat -c %s -- "$candidate" 2>/dev/null)" = "$WRAPPER_SIZE" ] && cmp -s -- "$candidate" "$SELF_PATH"; then
      continue
    fi
    printf '%s\n' "$candidate"; return 0
  done
  return 1
}

CLAUDE_CLI="$(resolve_claude_cli)" || {
  echo "claude wrapper: no claude CLI found - set CLAUDE_CLI_PATH or put claude on PATH" >&2
  exit 127
}
exec "$CLAUDE_CLI" "${EXTRA_ARGS[@]}" "$@"

